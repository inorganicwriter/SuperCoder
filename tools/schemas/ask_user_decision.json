{
  "name": "ask_user_decision",
  "description": "Ask the user to choose. The turn stays suspended until the user answers or interrupts.",
  "mutating": false,
  "parameters": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "question": {
        "type": "string",
        "minLength": 1
      },
      "options": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "required": [
      "question"
    ]
  }
}
