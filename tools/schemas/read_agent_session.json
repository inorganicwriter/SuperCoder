{
  "name": "read_agent_session",
  "description": "Read one page of an executor's own historical session transcript.",
  "mutating": false,
  "parameters": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "agent_id": {
        "type": "string"
      },
      "session_id": {
        "type": "string"
      },
      "offset": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      },
      "limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 100
      }
    },
    "required": [
      "agent_id",
      "session_id",
      "offset",
      "limit"
    ]
  }
}
