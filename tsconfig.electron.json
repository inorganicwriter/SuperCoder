{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "Node16",
    "moduleResolution": "Node16",
    "outDir": "lib-electron",
    "rootDir": "electron",
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "noEmit": false,
    "declaration": false,
    "sourceMap": false,
    "verbatimModuleSyntax": false,
    "isolatedModules": false
  },
  "include": ["electron/**/*.cts"]
}
