{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "rootDir": ".",
    "outDir": "lib-scripts",
    "lib": ["ES2022"],
    "types": ["node"],
    "declaration": false,
    "sourceMap": false
  },
  "include": [
    "src/shared/**/*.ts",
    "src/host/**/*.ts",
    "tools/**/*.ts",
    "bench/**/*.ts",
    "test/helpers/crash-writer.ts",
    "test/helpers/host-runner.ts"
  ]
}
