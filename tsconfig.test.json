{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "declaration": false,
    "sourceMap": false,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM"],
    "types": ["node"],
    "jsx": "react-jsx",
    "allowImportingTsExtensions": true
  },
  "include": ["test/**/*.ts", "src/**/*.ts", "src/**/*.tsx", "tools/**/*.ts", "bench/**/*.ts"]
}
